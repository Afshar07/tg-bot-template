{
  "name": "telegram-bot-template",
  "version": "1.0.0",
  "private": true,
  "description": "A webhook-only Telegram bot template for Nitro and Vercel.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "webhook:set": "tsx scripts/webhook-set.ts",
    "webhook:info": "tsx scripts/webhook-info.ts",
    "webhook:delete": "tsx scripts/webhook-delete.ts"
  },
  "imports": {
    "#*": "./*"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "dotenv": "18.0.4",
    "nitro": "3.0.260903-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "grammy": "1.46.0"
  }
}
